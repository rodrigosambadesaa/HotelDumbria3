<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:gravity="center_vertical"
    android:minHeight="132dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.android.volley.toolbox.NetworkImageView
        android:id="@+id/niv_imagen_habitacion"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@color/image_placeholder"
        android:contentDescription="@string/room_photo"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_numero_habitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_precio_habitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/brand_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_area_habitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_numero_huespedes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/chk_reservar_habitacion"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:buttonTint="@color/checkbox_tint"
            android:gravity="center_vertical"
            android:text="@string/select_room"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
