<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#4d80e4"
    android:paddingBottom="10dp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="10dp"
    android:theme="@style/Theme.AppCompat.NoActionBar"
    android:orientation="vertical"
    tools:ignore="HardcodedText" >

    <EditText
        android:id="@+id/edt_nif"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/cabecera"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:layout_alignParentStart="true"
        android:hint="NIF"
        android:inputType="text"
        tools:targetApi="o_mr1" />
    <!--android:autofillHints="@android:string/autofill"-->


    <EditText
        android:id="@+id/edt_email"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/edt_nif"
        android:hint="Email"
        android:inputType="textEmailAddress"
        tools:targetApi="o_mr1" />
    <!--android:autofillHints="@android:string/autofill"-->


    <EditText
        android:id="@+id/edt_clave"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/edt_email"
        android:hint="Contraseña"
        android:inputType="textPassword"
        tools:targetApi="o_mr1" />
    <!--android:autofillHints="@android:string/autofill"-->



    <EditText
        android:id="@+id/edt_nombre"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/edt_clave"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Nombre"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edt_apellido_1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/edt_nombre"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Primer apellido"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edt_apellido_2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/edt_apellido_1"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Segundo apellido"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edt_calle"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/edt_apellido_2"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Calle"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edt_numero"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/edt_calle"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Número"
        android:inputType="number"/>

    <EditText
        android:id="@+id/edt_codigo_postal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/edt_bloque"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Código postal"
        android:inputType="number"/>

    <EditText
        android:id="@+id/edt_piso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/edt_numero"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Piso"
        android:inputType="number"/>

    <EditText
        android:id="@+id/edt_puerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/edt_piso"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Puerta"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edt_escalera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/edt_puerta"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Escalera"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edt_bloque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_below="@id/edt_escalera"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        android:hint="Bloque"
        android:inputType="number"/>



    <TextView
        android:id="@+id/tv_poblacion"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/edt_codigo_postal"
        android:inputType="text"
        android:textColor="@color/color_poblacionesprovincias"
        android:textSize="@dimen/tamanho_texto_poblacionesprovincias"
        android:background="@android:color/holo_red_dark"
        android:text="Población">
    </TextView>

    <TextView
        android:id="@+id/tv_provincia"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="Provincia"
        android:inputType="text"
        android:textColor="@color/color_poblacionesprovincias"
        android:background="@android:color/holo_red_dark"
        android:textSize="@dimen/tamanho_texto_poblacionesprovincias"
        android:layout_below="@id/tv_poblacion"></TextView>

    <RadioGroup
        android:id="@+id/rdg_sexo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_provincia"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/margen_elementos_activity_datos"
        >

        <RadioButton
            android:id="@+id/rb_hombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Hombre"
            android:textColor="#000000"
            android:textColorHint="#000000" />

        <RadioButton
            android:id="@+id/rb_mujer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mujer"
            android:textColor="#000000"
            android:textColorHint="#000000" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_below="@id/rdg_sexo"
        android:layout_alignParentStart="true"
        >

        <Button
            android:id="@+id/bt_reservar_habitacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aceptar" />

        <Button
            android:id="@+id/bt_cancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="#FF0000" />
    </LinearLayout>

    <TextView
        android:id="@+id/cabecera"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/edt_email"
        android:layout_alignParentTop="true"
        android:padding="10dp"
        android:text="Regístrese"
        android:textColor="#000000"
        android:textSize="40sp" />

    <ProgressBar
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:id="@+id/pgb_confirmacion_reservas" />

    <ListView
        android:id="@+id/lv_poblaciones_provincias"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_below="@id/edt_codigo_postal"></ListView>
</RelativeLayout>
</ScrollView>

