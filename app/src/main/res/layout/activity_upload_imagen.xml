<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <Button
        android:id="@+id/btn_SeleccionaImagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="Selecciona Imagen" />
    <Button
        android:id="@+id/btn_sacarFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/btn_SeleccionaImagen"
        android:text="Sacar Foto" />


    <ImageView
        android:id="@+id/imgv_imagen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_UploadImagen"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_below="@+id/btn_sacarFoto"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/btn_UploadImagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Establecer Como Foto de Perfil"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        />

    <TextView
        android:id="@+id/tv_datos_imagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/imgv_imagen"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:textIsSelectable="true"
        android:text="" />



</RelativeLayout>